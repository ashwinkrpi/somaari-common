{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ashwinkrpi/somaari-common/apps/apps.schema.json",
  "title": "somaari app manifest",
  "description": "Every somaari app in landing-page display order, with the facts the landing cards, somaari.in and docs.somaari.in need.",
  "type": "object",
  "additionalProperties": false,
  "required": ["github", "apps"],
  "properties": {
    "github": { "type": "string", "pattern": "^[A-Za-z0-9-]+$" },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/app" }
    }
  },
  "$defs": {
    "app": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repo", "title", "status", "public", "description", "tags", "ai", "detail_page"],
      "properties": {
        "repo": { "type": "string", "pattern": "^somaari-[a-z0-9-]+$" },
        "title": { "type": "string", "minLength": 1 },
        "status": { "enum": ["live", "dev", "soon"] },
        "public": { "type": "boolean" },
        "description": { "type": "string", "minLength": 1 },
        "tags": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "ai": {
          "type": "object",
          "additionalProperties": false,
          "required": ["label", "source"],
          "properties": {
            "label": {
              "description": "AI chip text; a list when the card shows more than one AI chip.",
              "anyOf": [
                { "type": "string", "minLength": 1 },
                { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
              ]
            },
            "source": { "type": "string", "minLength": 1 }
          }
        },
        "detail_page": { "type": "boolean" },
        "demo": {
          "description": "Where the app repo keeps its demo files, as in somaari-site's docs.config.json.",
          "type": "object",
          "additionalProperties": false,
          "required": ["ref"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 }
          }
        },
        "screenshot": {
          "description": "Theme id to screenshot path in the app repo, as in somaari-site's docs.config.json.",
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[^\\s/][^\\s]*$" }
        },
        "guide": {
          "type": "object",
          "additionalProperties": false,
          "required": ["ref", "src"],
          "properties": {
            "ref": { "type": "string", "minLength": 1 },
            "src": { "type": "string", "pattern": "^[^\\s/][^\\s]*\\.md$" }
          }
        }
      }
    }
  }
}
